FROM node:22-alpine
WORKDIR /app
COPY package*.json ./
RUN npm install --omit=dev
COPY . .
# Railway ejecuta el worker directamente bajo Node ESM, sin el bundler de Next/Vercel.
# Normaliza imports relativos antiguos sin mantener una lista manual por módulo.
RUN node scripts/normalize-worker-imports.mjs lib
CMD ["npm","run","worker:batch-plex"]
