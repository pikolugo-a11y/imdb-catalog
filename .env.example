DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
TMDB_API_TOKEN=
OMDB_API_KEY=
PLEX_TOKEN=
# Required in Vercel Production. Vercel Cron sends it as Authorization: Bearer <CRON_SECRET>.
# Use a long random value and never commit the real secret.
CRON_SECRET=
# Optional. If omitted, PikoFilm discovers the remote Plex URL through plex.tv resources.
PLEX_URL=
# Optional Railway Plex tuning. Defaults: 3 concurrent inventory pages (hard cap 6) and 15s minimum between durable item heartbeats.
PLEX_EPISODE_PAGE_CONCURRENCY=3
BATCH_CHILD_HEARTBEAT_MIN_MS=15000
