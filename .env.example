DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
TMDB_API_TOKEN=
OMDB_API_KEY=
PLEX_TOKEN=
# Required in Vercel Production. Vercel Cron sends it as Authorization: Bearer <CRON_SECRET>.
# Use a long random value and never commit the real secret.
CRON_SECRET=
# Optional. If omitted, PikoFilm discovers the remote Plex URL through plex.tv resources.
PLEX_URL=
